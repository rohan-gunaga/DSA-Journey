class Solution(object):
    def longestConsecutive(self, nums):

        seen = set(nums) 
        longest = 0

        for num in nums:
            if num - 1 not in seen:
                current = num 
                length = 1


                while current + 1 in seen:
                    current += 1
                    length += 1

                    if length > longest:
                        longest = length

        return longest

        